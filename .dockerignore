# Deny everything, then allow back exactly what the build needs. This way a new
# file in the repo (a .env, a dump, a key) cannot silently end up in the image.
*

!pyproject.toml
!uv.lock
!README.md
!src/
!gunicorn.conf.py

# Secrets are never baked into a layer: compose reads .env on the host and
# injects it at run time. The leading `*` already covers this; it is spelled
# out so that nobody "fixes" a build by allowlisting it.
.env
.env.*

# ...and re-exclude anything unwanted that the src/ rule just pulled back in.
src/**/__pycache__/
src/**/*.py[co]
src/shopping.db
src/*.db
src/*.db-journal
src/*.db-wal
src/*.db-shm
