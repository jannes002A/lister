# Configuration for the docker compose deployment.
#
#   cp .env.example .env
#   python -c 'import secrets; print("LISTER_SECRET_KEY=" + secrets.token_hex(32))' >> .env
#
# `.env` is gitignored and excluded from the image by .dockerignore -- it is
# read by compose at `up` time and passed into the container's environment, so
# it never has to be baked into a layer. Keep real values only in `.env`.

# ---------------------------------------------------------------- required
# Flask's signing key for session cookies. 64 hex characters from a CSPRNG.
# The app refuses to start with LISTER_ENV=production and this unset, rather
# than falling back to a default that would be identical on every deployment.
# Rotating it invalidates existing session cookies, nothing else.
LISTER_SECRET_KEY=

# ---------------------------------------------------------------- optional
# "production" turns on the strict checks: no missing secret key, no debug
# server, Secure session cookies. Anything else means a dev workstation.
LISTER_ENV=production

# Host port the app is published on. It is bound to 127.0.0.1 in compose.yaml,
# so this is reachable from this machine only -- see the comment there before
# changing that.
LISTER_PORT=9000

# Send session cookies only over HTTPS. On by default when LISTER_ENV is
# production. Set to false only if you reach the app over plain http and
# understand that the cookie then travels in the clear.
# LISTER_SESSION_COOKIE_SECURE=true

# Largest request body accepted, in bytes. Default 262144 (256 KiB).
# LISTER_MAX_CONTENT_LENGTH=262144

# Gunicorn threads in the single worker process. Do not add worker *processes*:
# several of them writing one SQLite file deadlock on the whole-file lock.
# LISTER_THREADS=4

# error | warning | info | debug. "debug" logs every request line.
# LISTER_LOG_LEVEL=info

# Address of your reverse proxy, if any, so X-Forwarded-* headers from it are
# trusted. Never "*": that lets any client forge the client address in the logs.
# LISTER_FORWARDED_ALLOW_IPS=

# Where the SQLite file lives inside the container. /data is the only writable
# durable path (the root filesystem is read-only); change it only together with
# the volume mount in compose.yaml.
# LISTER_DB_PATH=/data/shopping.db
